[Unit]
Description=pi5 dashboard
After=network.target pi5-syncthing.service
Wants=pi5-syncthing.service

[Service]
User=pi5
Group=pi5
# vcgencmd, pinctrl and journalctl, all read-only in the technical section.
SupplementaryGroups=video gpio systemd-journal
UMask=0002
ExecStart=/usr/bin/python3 /opt/pi5-dashboard/app.py
Restart=on-failure
RestartSec=3

# Port 80 without root, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/pi5 /srv/pi5

[Install]
WantedBy=multi-user.target
